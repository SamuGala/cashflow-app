<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="8dp"
    android:background="@drawable/pocket_vault_widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pockets Vault"
        android:textColor="#6B7280"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="EUR 0,00"
        android:textColor="#111827"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Spese del mese"
        android:textColor="#6B7280"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_expenses"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="EUR 0,00"
        android:textColor="#DC2626"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#4F46E5"
        android:gravity="center"
        android:padding="10dp"
        android:text="+ Aggiungi movimento"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />
</LinearLayout>
